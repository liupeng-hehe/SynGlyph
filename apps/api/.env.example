# Copy to .env and adjust. Pydantic loads .env from apps/api cwd.

# SQLite (default local)
# DATABASE_URL=sqlite:///./synglyph.db

# PostgreSQL (staging / production)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/synglyph

# Browser origins allowed by CORS (comma-separated). Use explicit origins in staging/prod.
# SYNGLYPH_CORS_ORIGINS=https://your-frontend.example.com

# Optional: letter-sequence inference checkpoint
# LETTER_SEQUENCE_CHECKPOINT=/absolute/path/to/model.pt

# colorrec — text → color retrieval (HPC v2 checkpoint under color-semantic-model/)
# COLORREC_ENABLED=true
# COLORREC_REPO_ROOT=/absolute/path/to/SynGlyph/color-semantic-model
# COLORREC_CONFIG=configs/deploy_api.yaml
# COLORREC_MODEL_PATH=/absolute/path/to/models/hpc_color_sentence_transformer_v2
# COLORREC_EMBEDDINGS_PATH=/absolute/path/to/artifacts/candidate_bank/candidate_embeddings_hpc_v2.npy
